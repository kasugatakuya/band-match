# ローカル開発用の設定。`cp .env.example .env` して使う。
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://bandmatch:bandmatch@localhost:54329/bandmatch?sslmode=disable
# ブラウザから見えるサイトの URL(API もこのドメインの /api 経由で呼ばれる)
FRONTEND_URL=http://localhost:3000

# Google ログイン(未設定の間は Google ログインボタンが出ない)。作り方は README 参照
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# メール: smtp(ローカルの Mailpit)/ resend(本番)/ log(ログに出すだけ)
MAIL_DRIVER=smtp
SMTP_ADDR=localhost:1025
MAIL_FROM=BandMatch <no-reply@localhost>
RESEND_API_KEY=
